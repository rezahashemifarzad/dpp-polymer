# ---------------------------------------------------------------------------
# DPP-Polymer — environment variables
# Copy to .env (local) or add in Vercel → Project → Settings → Environment
# Variables (Production). Never commit real values.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------
# Neon PostgreSQL connection string (read by prisma.config.ts)
DATABASE_URL=

# Public base URL used in every GS1 Digital Link / QR code (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://your-production-domain.example

# Optional: email notifications ------------------------------------------------
# Leave both empty to run in-app only: alerts still appear on /admin/notifications,
# are logged as SKIPPED for email, and are still delivered to webhooks.
RESEND_API_KEY=
# A sender on a domain verified in Resend, e.g. "DPP-Polymer <alerts@your-domain.example>"
DPP_NOTIFICATION_EMAIL_FROM=

# Optional: scheduled sweep ---------------------------------------------------
# Bearer secret for GET /api/notifications/sweep (Vercel Cron, daily 06:00 UTC)
CRON_SECRET=

# Optional: machine/API role keys (each fails closed when unset) -----------------
DPP_MANUFACTURER_API_KEY=
DPP_AUDITOR_API_KEY=
DPP_ADMIN_API_KEY=
