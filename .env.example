# ---------------------------------------------------------------------------
# DPP-Polymer — environment variables
# Copy to .env (local) or add in Vercel → Project → Settings → Environment
# Variables (Production). Never commit real values.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------
# Neon PostgreSQL connection string (read by prisma.config.ts)
DATABASE_URL=

# Public base URL used in every GS1 Digital Link / QR code (no trailing slash)
# Production: https://dpp-polymer.de (www.dpp-polymer.de redirects to it).
# Local dev: put NEXT_PUBLIC_BASE_URL=http://localhost:3000 in .env.local instead.
NEXT_PUBLIC_BASE_URL=https://dpp-polymer.de

# Official contact mailbox shown on the site (footer, pilot CTA, Imprint, privacy)
NEXT_PUBLIC_CONTACT_EMAIL=info@dpp-polymer.de

# Optional: email notifications ------------------------------------------------
# Leave RESEND_API_KEY empty to run in-app only: alerts still appear on /admin/notifications,
# are logged as SKIPPED for email, and are still delivered to webhooks.
RESEND_API_KEY=
# Sender; dpp-polymer.de must be verified in Resend (resend.com/domains).
# Defaults to this value when left empty.
DPP_NOTIFICATION_EMAIL_FROM="DPP-Polymer <info@dpp-polymer.de>"

# Optional: scheduled sweep ---------------------------------------------------
# Bearer secret for GET /api/notifications/sweep (Vercel Cron, daily 06:00 UTC)
CRON_SECRET=

# Optional: machine/API role keys (each fails closed when unset) -----------------
DPP_MANUFACTURER_API_KEY=
DPP_AUDITOR_API_KEY=
DPP_ADMIN_API_KEY=
