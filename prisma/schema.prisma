generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum PolymerType {
  PET
  HDPE
  PVC
  LDPE
  PP
  PS
  PLA // bio-based
  PHA // bio-based
  PA // Polyamide / Nylon
  PC // Polycarbonate
  ABS
  OTHER
}

enum RecycledContentSource {
  POST_CONSUMER // PCR
  POST_INDUSTRIAL // PIR
  VIRGIN
  BIO_BASED
}

enum CertificationScheme {
  ISCC_PLUS
  REDCERT2 // REDcert2 sustainability certification for bio-based/renewable feedstocks
  ISO_14021 // Self-declared environmental claims
  ISO_14040_44 // LCA standard
  EN_15343 // Plastics recycling traceability
  EN_16785 // Bio-based content
  GRS // Global Recycled Standard
  RECYCLASS
  OTHER
}

enum DppStatus {
  DRAFT
  PENDING_VERIFICATION
  ISSUED
  REVOKED
  SUPERSEDED // replaced by a newer batch record
}

// STEP 5: audit trail action taxonomy. Additive — does not touch any
// existing enum or model.
enum AuditAction {
  CREATED
  VERIFIED
  REVOKED
  SUPERSEDED
  UPDATED
  // Compliance & Green Certifications Module — additive, existing values
  // and rows untouched. See docs/COMPLIANCE_CERTIFICATIONS_MODULE_SPEC.md.
  CERT_ADDED
  CERT_VERIFIED
  CERT_REJECTED
  // Circular Economy Platform Upgrade — additive, existing values and
  // rows untouched. See docs/CIRCULAR_ECONOMY_PLATFORM_UPGRADE_SPEC.md.
  GENEALOGY_LINKED
  CARBON_CALCULATED
  // Third-Party Auditor Verification Workflow — additive, existing values
  // and rows untouched. Deliberately distinct from VERIFIED/REVOKED (the
  // generic shared-role-key transition already used by
  // app/api/passports/[batchId]/route.ts's PATCH) so the audit trail can
  // tell "the AUDITOR-role key was used to flip status" apart from "a
  // specific, individually-authenticated Auditor formally signed or
  // rejected this batch through the review portal."
  AUDITOR_VERIFIED
  AUDITOR_REJECTED
  // B2B Client Portal & Buyer API Access — additive, existing values and
  // rows untouched. Written whenever an admin records that a batch was
  // sold/allocated to a Client (see lib/services/allocate-passport-to-client.ts) —
  // the one write this feature makes against an existing PolymerPassport,
  // so it gets its own audit trail entry like every other passport-level
  // event in this app.
  CLIENT_PURCHASE_RECORDED
  // Multi-tier Supply Chain Verification & Auditor Portal Expansion —
  // additive, existing values and rows untouched. See
  // ChainOfCustodyRecord below. COC_VERIFIED/COC_FLAGGED/COC_REJECTED are
  // deliberately distinct from AUDITOR_VERIFIED/AUDITOR_REJECTED (which
  // record a decision about the whole passport) — these record a decision
  // about one supply-chain tier record instead, and a single passport can
  // have many independently-reviewed tier records.
  COC_ADDED
  COC_VERIFIED
  COC_FLAGGED
  COC_REJECTED
  // Green Accounting & EU Plastic Tax Tracker — additive, existing values
  // and rows untouched. Written whenever a locked, auditable
  // BatchGreenValuation snapshot is saved for a passport (see
  // lib/services/plastic-tax-calculator.ts). Deliberately distinct from
  // CARBON_CALCULATED — a green valuation is a financial/tax figure, not
  // an emissions estimate, even though both derive from the same recorded
  // batch weight.
  GREEN_VALUATION_SAVED
  // Phase 4 - Step 1: Automated Expiry & Compliance Alerts — additive,
  // existing values and rows untouched. CERT_EXPIRY_ALERT_RAISED is
  // written by the background check (lib/services/expiry-alert-service.ts)
  // whenever a certification's computed expiry tier escalates past what
  // was last notified; CERT_EXPIRY_ALERT_ACKNOWLEDGED is written when an
  // admin dismisses a raised alert from the compliance dashboard.
  CERT_EXPIRY_ALERT_RAISED
  CERT_EXPIRY_ALERT_ACKNOWLEDGED
  // Phase 4 - Step 2: Supplier Onboarding Portal — additive, existing
  // values and rows untouched. Written ONLY at the moment an admin
  // approves a pending SupplierSubmission and it becomes a real
  // PolymerPassport (see lib/services/supplier-submission.ts). Everything
  // that happens before approval (an invite being created, a submission
  // being received or rejected) has no PolymerPassport row yet to attach
  // an AuditLog entry to — writeAuditLog() requires a non-nullable
  // passportId — so those pre-approval events are tracked on
  // SupplierInvite/SupplierSubmission's own fields instead (invitedBy/
  // invitedAt, reviewedBy/reviewedAt/reviewNotes/status). Deliberately
  // distinct from the plain CREATED action so the audit trail can always
  // tell "a manufacturer created this directly via the API" apart from
  // "this passport originated from an external supplier's onboarding
  // submission and was approved by an admin."
  SUPPLIER_SUBMISSION_APPROVED
}

// Compliance & Green Certifications Module (docs/COMPLIANCE_CERTIFICATIONS_MODULE_SPEC.md
// §2.2). Deliberately has NO "EXPIRED" member: expiry is a fact derived
// from Certification.validUntil vs. the current date, not a human
// decision — compute it at read time (verificationStatus === VERIFIED &&
// validUntil > now()) rather than storing it, or a certification nobody
// re-checks stays stuck at a stale stored state forever.
enum CertificationVerificationStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

// Phase 4 - Step 1: Automated Expiry & Compliance Alerts. Distinct from
// CertificationVerificationStatus on purpose: this tracks NOTIFICATION
// bookkeeping (has an alert already been raised, and at what severity),
// not the underlying fact of expiry itself — that fact is still always
// computed live from validUntil (see lib/utils/certification-status.ts's
// getExpiryAlertTier), never stored, for the same "don't let a stored
// value silently go stale" reason CertificationVerificationStatus has no
// EXPIRED member. What can't be recomputed live is whether an alert has
// already been surfaced/acknowledged — that's state, not a re-derivable
// fact, and has to persist somewhere for "don't re-notify a dismissed
// alert, but do re-notify on escalation" to be possible at all.
enum ExpiryAlertLevel {
  EXPIRING_SOON // <= 30 days remaining
  EXPIRING_URGENT // <= 7 days remaining
  EXPIRED // already past validUntil
}

// Circular Economy Platform Upgrade (docs/CIRCULAR_ECONOMY_PLATFORM_UPGRADE_SPEC.md
// §1.2) — freight mode driving the Scope 3 transport emission factor in
// lib/utils/carbon-footprint-calculator.ts.
enum TransportMode {
  TRUCK
  RAIL
  SEA
  AIR
}

// Third-Party Auditor Verification Workflow — new enum, additive, no
// existing enum or model touched. Deliberately its own type rather than
// reusing DppStatus or CertificationVerificationStatus: an
// AuditorVerification row is a permanent, individually-signed record of
// one review event, not a mutable current-state field, so its value set
// only ever grows (a correction is a NEW row, never an edit of this one).
enum AuditorVerificationStatus {
  AUDITOR_VERIFIED
  REJECTED_BY_AUDITOR
}

// Multi-tier Supply Chain Verification & Auditor Portal Expansion — new
// enums, additive, no existing enum touched.
//
// A tier in a batch's chain of custody: who touched the material before it
// became this Digital Product Passport's own batch. Deliberately NOT the
// same concept as BatchGenealogyLink (which links two batches that BOTH
// already have their own PolymerPassport row in this system) — a raw
// material supplier or recycler upstream of the DPP boundary usually has
// no passport of their own here at all, just a name, a batch/lot
// reference, and a certificate. ChainOfCustodyRecord is how that external,
// pre-DPP portion of the supply chain gets attached to a single passport.
enum ChainOfCustodyTier {
  RAW_MATERIAL_SUPPLIER
  RECYCLER
  COMPOUNDER
  PROCESSOR
  DISTRIBUTOR
  OTHER
}

// Mirrors CertificationVerificationStatus's shape (PENDING_REVIEW by
// default, moved by a separate reviewer) plus one addition this feature's
// own spec calls for: FLAGGED — a reviewer's way of raising a compliance
// concern about a tier record without outright rejecting it (a rejection
// says "this record is wrong/unacceptable"; a flag says "this needs
// follow-up before it can be trusted," e.g. a certificate nearing expiry
// or a mismatched mass-balance figure). Both FLAGGED and REJECTED carry a
// required flagReason/reviewNotes — see the model below.
enum ChainOfCustodyStatus {
  PENDING_REVIEW
  VERIFIED
  FLAGGED
  REJECTED
}

// Supplier Onboarding Portal — new enum, additive, no existing enum
// touched. Mirrors CertificationVerificationStatus/ChainOfCustodyStatus's
// own "start unreviewed, moved only by a separate reviewer" shape, kept as
// its own type (not a reuse of DppStatus) since a SupplierSubmission is a
// proposal that may never become a passport at all, not a passport whose
// status is changing.
enum SupplierSubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ----------------------------------------------------------------------------
// CORE MODEL
// ----------------------------------------------------------------------------

model PolymerPassport {
  id String @id @default(uuid())

  // --- 1. Material Identification -----------------------------------------
  polymerType         PolymerType
  grade               String // e.g. "Injection Molding Grade IM-450"
  meltFlowIndex       Decimal     @db.Decimal(6, 2) // g/10min
  mfiTestStandard     String      @default("ISO 1133") // test conditions matter for MFI comparability
  density             Decimal     @db.Decimal(5, 3) // g/cm³
  densityTestStandard String      @default("ISO 1183")
  colorAdditives      String? // free text; relevant to recyclability downstream

  // GS1 identification
  gtin String @default("00000000000000") @db.Char(14)

  // --- 2. Sustainability & Recycled Content ---------------------------------
  recycledContentSource     RecycledContentSource?
  recycledContentPercent    Decimal                @default(0) @db.Decimal(5, 2)
  recycledContentCertScheme CertificationScheme?
  totalRecycledPercent      Decimal                @default(0) @db.Decimal(5, 2)
  bioBasedPercent           Decimal                @default(0) @db.Decimal(5, 2)
  bioBasedTestStandard      String?

  // Carbon footprint
  carbonFootprintKgCO2ePerKg Decimal @default(0) @db.Decimal(8, 3)
  lcaMethodology             String  @default("PEF")
  lcaScope                   String  @default("cradle-to-gate")
  lcaThirdPartyVerified      Boolean @default(false)
  lcaVerifierName            String?

  // --- 3. Supply Chain & Certification --------------------------------------
  batchId           String        @unique
  manufacturerId    String?
  manufacturer      Manufacturer? @relation(fields: [manufacturerId], references: [id])
  productionDate    DateTime      @default(now())
  productionSiteGln String?

  certifications Certification[]

  // --- 4. Cryptographic Integrity --------------------------------------------
  recordHash         String?   @unique
  hashAlgorithm      String    @default("SHA-256")
  previousRecordHash String?
  signedAt           DateTime?
  signedBy           String?

  // --- 5. Audit Trail (STEP 5 addition) --------------------------------------
  auditLogs AuditLog[]

  // --- 6. GS1 Digital Link resolver record (STEP 5 addition) -----------------
  // 1:1 with this passport, written in the SAME transaction as the passport
  // itself (see app/api/passports/route.ts) — a passport row can never exist
  // without its resolver row, so a public QR/link lookup can never come back
  // "No GS1 Link record found" for a batch that was actually created here.
  gs1Link GS1DigitalLink?

  // --- 7. Batch Genealogy (Circular Economy Platform Upgrade) -----------------
  // See docs/CIRCULAR_ECONOMY_PLATFORM_UPGRADE_SPEC.md §1.1. Many-to-many
  // via an explicit join model (not Prisma's implicit m2m) so each link can
  // carry its own data (quantityUsedKg, notes) and its own audit trail.
  parentLinks BatchGenealogyLink[] @relation("GenealogyChild") // this batch's upstream inputs
  childLinks  BatchGenealogyLink[] @relation("GenealogyParent") // downstream batches made from this one

  // --- 8. Carbon Footprint Calculation (Circular Economy Platform Upgrade) ---
  // See docs/CIRCULAR_ECONOMY_PLATFORM_UPGRADE_SPEC.md §1.2. Deliberately a
  // separate table from carbonFootprintKgCO2ePerKg above, which remains the
  // manufacturer's own (optionally third-party-verified) LCA figure — this
  // relation is the rough, clearly-labeled Scope 1/2/3 estimate and must
  // never overwrite or be conflated with that verified figure.
  carbonFootprintCalculation CarbonFootprintCalculation?

  // --- 9. Auditor Verifications (Third-Party Auditor Verification Workflow) --
  // See the Auditor / AuditorVerification models below. One-to-many:
  // corrections/re-reviews create a NEW row rather than editing an old one,
  // so the full review history for a batch is always reconstructable. The
  // "current" sign-off is whichever row has the latest signedAt — resolved
  // at read time (lib/verifyPassport.ts), never cached on this model, per
  // the app's existing "compute, don't store" convention.
  auditorVerifications AuditorVerification[]

  // --- 10. Client Purchase Allocations (B2B Client Portal & Buyer API) -------
  // See the Client / ClientPassportAccess models below. Many-to-many in
  // principle (a batch could in theory be split across multiple buyers),
  // modeled as an explicit join table for the same reason as
  // BatchGenealogyLink above — so each allocation can carry its own
  // quantity/notes and its own place in the audit trail.
  clientAccess ClientPassportAccess[]

  // --- 11. Multi-Tier Chain of Custody (Multi-tier Supply Chain
  // Verification & Auditor Portal Expansion) ---------------------------------
  // See ChainOfCustodyRecord below. One-to-many, ordered by `sequence` —
  // every raw material supplier, recycler, and compounder tier that fed
  // into this batch, each independently reviewable by an Auditor.
  chainOfCustodyRecords ChainOfCustodyRecord[]

  // --- 12. Green Accounting & EU Plastic Tax Tracker --------------------------
  // See BatchGreenValuation below. Optional, user-triggered snapshot of this
  // batch's plastic-tax financial assessment — the live dashboard/API
  // always computes fresh figures by default (lib/services/
  // plastic-tax-calculator.ts); this relation only exists once someone
  // explicitly locks a valuation for audit/filing purposes.
  greenValuation BatchGreenValuation?

  // --- 13. Supplier Onboarding Portal -----------------------------------------
  // See SupplierSubmission below. Optional 1:1 back-relation: set only when
  // this passport originated from an admin-approved external supplier
  // submission rather than a direct manufacturer/admin API call. Absent
  // (null) for every passport created the ordinary way — this is purely
  // provenance metadata, never required.
  originatingSupplierSubmission SupplierSubmission?

  // --- Lifecycle / meta --------------------------------------------------
  status           DppStatus @default(ISSUED)
  qrCodePayloadUrl String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([polymerType])
  @@index([status])
  @@index([gtin])
  @@index([manufacturerId]) // STEP 5: added — high-frequency filter in GET /api/passports
  @@index([productionDate]) // Final Polish & Stability Sprint: green-tax-trend-forecast.ts and esg-analytics.ts's monthly trend both range-scan/bucket by this column
}

// ----------------------------------------------------------------------------
// SUPPORTING MODELS
// ----------------------------------------------------------------------------

model Manufacturer {
  id        String            @id @default(uuid())
  legalName String
  vatNumber String?           @unique
  gln       String?
  country   String
  passports PolymerPassport[]
  createdAt DateTime          @default(now())

  // Supplier Onboarding Portal — back-relation only. A Manufacturer row
  // resolved/cached for a given supplier (or auto-created at first
  // approval — see lib/services/supplier-submission.ts) may have zero or
  // more standing SupplierInvite rows pointing at it.
  supplierInvites SupplierInvite[]
}

model Certification {
  id            String              @id @default(uuid())
  scheme        CertificationScheme
  certificateId String
  issuingBody   String
  validFrom     DateTime
  validUntil    DateTime
  documentUrl   String?

  // --- Compliance & Green Certifications Module additions -----------------
  // See docs/COMPLIANCE_CERTIFICATIONS_MODULE_SPEC.md §2.2-2.3. All fields
  // below are new and optional/defaulted — no existing column touched.

  // Verification workflow: every certification starts PENDING_REVIEW: a
  // manufacturer's own submission is never implicitly trusted. Moved to
  // VERIFIED/REJECTED only by a separate Auditor/Admin actor (see
  // lib/rbac.ts), mirroring PolymerPassport.status's PENDING_VERIFICATION
  // -> ISSUED pattern.
  verificationStatus CertificationVerificationStatus @default(PENDING_REVIEW)
  verifiedBy         String? // actor identity, same convention as AuditLog.actor (e.g. "AUDITOR:<uuid>")
  verifiedAt         DateTime?
  rejectionReason    String? // required by the API when moving to REJECTED

  // Document integrity: mirrors PolymerPassport.recordHash — a SHA-256 of
  // the uploaded/linked certificate document, so a swapped or edited PDF
  // behind an unchanged documentUrl is detectable.
  documentHash String?

  // ISCC PLUS / mass-balance specific. Only meaningful when scheme is a
  // mass-balance scheme (ISCC_PLUS, REDCERT2); left null otherwise —
  // validated conditionally in the Zod schema, not a DB constraint, so the
  // column stays usable for every scheme.
  massBalanceAllocationPercent Decimal? @db.Decimal(5, 2)

  // --- Phase 4 - Step 1: Automated Expiry & Compliance Alerts -------------
  // Notification bookkeeping only — see the ExpiryAlertLevel enum comment
  // above for why this is state, not a re-derivable fact, and therefore
  // has to be stored unlike verificationStatus's own expiry handling.
  // lastNotifiedLevel/lastNotifiedAt are written by the background check
  // (lib/services/expiry-alert-service.ts's runExpiryAlertCheck) whenever
  // a cert's live-computed tier escalates past what was last notified;
  // that same escalation also clears alertAcknowledgedAt/By, so a
  // previously-dismissed alert resurfaces if the situation gets worse.
  lastNotifiedLevel   ExpiryAlertLevel?
  lastNotifiedAt      DateTime?
  alertAcknowledgedAt DateTime?
  alertAcknowledgedBy String? // actor identity, same convention as AuditLog.actor

  passportId String
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  @@index([passportId])
  @@index([scheme])
  @@index([verificationStatus]) // admin "pending review" queue filters on this
  @@index([validUntil]) // Phase 4 - Step 1: background check + dashboard widget query directly on this
  @@index([lastNotifiedLevel]) // Phase 4 - Step 1: "what's currently flagged" queries
}

// ----------------------------------------------------------------------------
// AUDIT LOG (STEP 5 addition — new model, no existing model touched)
// ----------------------------------------------------------------------------

model AuditLog {
  id String @id @default(uuid())

  passportId String
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  action       AuditAction
  actor        String // role or service identity that performed the action
  // (e.g. "manufacturer:<uuid>", "AUDITOR", "ADMIN")
  previousHash String?
  newHash      String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@index([passportId])
  @@index([action])
}

// ----------------------------------------------------------------------------
// GS1 DIGITAL LINK RESOLVER (STEP 5 addition — new model, no existing model
// or field touched or removed)
// ----------------------------------------------------------------------------
// A dedicated, independently-queryable resolver record for every passport's
// GS1 Digital Link (GTIN + batchId -> public verification URL). This is
// deliberately a separate table from PolymerPassport.qrCodePayloadUrl, not a
// replacement for it: whatever code path renders the public QR / "verify
// this batch" page can resolve a scan by GTIN+batchId (the GS1 Digital Link
// syntax, /01/{GTIN}/21/{BATCH} — matching the real resolver route at
// app/01/[gtin]/21/[serialOrBatch]/page.tsx) directly against this table
// without having
// to know anything else about the passport schema. It is written inside the
// SAME prisma.$transaction() call that creates the PolymerPassport row (see
// app/api/passports/route.ts) — so the two rows are created atomically, and
// a passport can never exist without a matching, resolvable GS1 link record.
model GS1DigitalLink {
  id String @id @default(uuid())

  gtin        String @db.Char(14)
  batchId     String
  resolverUri String @unique // GS1 Digital Link path: /01/{GTIN}/21/{BATCH}
  targetUrl   String // full public verification URL (resolverUri + ?v=<hash prefix>)
  recordHash  String

  passportId String          @unique
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  createdAt DateTime @default(now())

  @@index([gtin, batchId])
}

// ----------------------------------------------------------------------------
// BATCH GENEALOGY (Circular Economy Platform Upgrade — new model, no
// existing model or field touched or removed)
// ----------------------------------------------------------------------------
// Records that `childPassport` was (in whole or in part) compounded from
// `parentPassport` — e.g. a PP grade blending two recycled feedstock lots.
// A many-to-many relationship: one batch can have multiple parent batches,
// and one batch can feed multiple downstream batches. Modeled as an
// explicit join table (not Prisma's implicit m2m) so the link itself can
// carry quantityUsedKg/notes and participate in the audit trail (see
// AuditAction.GENEALOGY_LINKED).
//
// Cycle prevention (a batch can never be its own ancestor) is enforced in
// application code before a link is created — see
// docs/CIRCULAR_ECONOMY_PLATFORM_UPGRADE_SPEC.md §1.1 and §2.1 — not by a
// DB constraint, since Postgres has no native "no cycles in this graph"
// check.
model BatchGenealogyLink {
  id String @id @default(uuid())

  parentPassportId String
  parentPassport   PolymerPassport @relation("GenealogyParent", fields: [parentPassportId], references: [id])

  childPassportId String
  childPassport   PolymerPassport @relation("GenealogyChild", fields: [childPassportId], references: [id])

  quantityUsedKg Decimal? @db.Decimal(10, 3) // how much of the parent batch went into this child batch
  notes          String?

  createdAt DateTime @default(now())

  @@unique([parentPassportId, childPassportId])
  @@index([parentPassportId])
  @@index([childPassportId])
}

// ----------------------------------------------------------------------------
// CARBON FOOTPRINT CALCULATION (Circular Economy Platform Upgrade — new
// model, no existing model or field touched or removed)
// ----------------------------------------------------------------------------
// A rough, illustrative Scope 1/2/3 CO2e estimate computed by
// lib/utils/carbon-footprint-calculator.ts from weight/transport inputs.
// Deliberately separate from PolymerPassport.carbonFootprintKgCO2ePerKg,
// which is the manufacturer's own (optionally third-party-verified) LCA
// figure — this table must never be conflated with or silently overwrite
// that one. `@unique` on passportId keeps this "latest calculation only"
// for MVP simplicity; drop it (and add an index on
// [passportId, calculatedAt]) if calculation history is ever needed.
model CarbonFootprintCalculation {
  id String @id @default(uuid())

  passportId String          @unique
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  weightKg            Decimal       @db.Decimal(10, 3)
  transportDistanceKm Decimal       @default(0) @db.Decimal(10, 2)
  transportMode       TransportMode @default(TRUCK)

  scope1KgCO2e Decimal @db.Decimal(10, 3) // on-site processing (direct)
  scope2KgCO2e Decimal @db.Decimal(10, 3) // purchased energy for processing
  scope3KgCO2e Decimal @db.Decimal(10, 3) // transport/logistics
  totalKgCO2e  Decimal @db.Decimal(10, 3)

  // Ties a stored result to the exact factor table that produced it (see
  // EMISSION_FACTOR_VERSION in the calculator utility), so results stay
  // explainable after factors are later updated.
  emissionFactorVersion String   @default("illustrative-v1-2026")
  calculatedAt          DateTime @default(now())
}

// ----------------------------------------------------------------------------
// THIRD-PARTY AUDITOR VERIFICATION WORKFLOW (new models, no existing model
// or field touched or removed)
// ----------------------------------------------------------------------------
// This app has no general login system — every write today goes through a
// single shared per-role API key checked by lib/rbac.ts's authorize(). That
// remains true for MANUFACTURER/ADMIN. Auditors are the one exception: a
// digital "signature" is only meaningful if it is attributable to a specific
// person, not to "whoever currently holds the shared AUDITOR key." So each
// Auditor gets their OWN personal key (like a personal access token) —
// still simple header-based auth, no session cookies, no new dependency —
// but the credential itself now identifies the individual. See
// lib/auditor-auth.ts for the lookup and scripts/create-auditor.ts for
// provisioning.
//
// apiKeyHash stores a SHA-256 hash of the raw key, never the raw key itself
// (same principle as a password hash) — the raw value is shown to the
// operator exactly once, at creation time, by the CLI script, and is not
// recoverable from the database afterward.
model Auditor {
  id           String  @id @default(uuid())
  name         String
  organization String
  email        String? @unique
  apiKeyHash   String  @unique
  active       Boolean @default(true) // soft-revoke: flip false to disable a lost/rotated key without deleting review history

  verifications AuditorVerification[]

  createdAt DateTime @default(now())

  @@index([apiKeyHash])
}

// One row per formal review decision an authenticated Auditor makes on a
// passport. Deliberately append-only / immutable once written (the API
// layer only ever creates rows here, never updates or deletes them) so the
// audit trail can't be quietly rewritten — a corrected decision is a new
// row with a later signedAt, not an edit of the old one.
//
// signatureHash is a SHA-256 (via lib/types.ts's hashRecord, the same
// helper used for PolymerPassport.recordHash) over the canonical
// verification claim (passportId, auditorId, status, notes, signedAt) —
// giving each sign-off its own tamper-evident fingerprint, distinct from
// and in addition to the passport's own recordHash chain.
model AuditorVerification {
  id String @id @default(uuid())

  passportId String
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  auditorId String
  auditor   Auditor @relation(fields: [auditorId], references: [id])

  status AuditorVerificationStatus

  // Compliance remarks / rationale. Admin+portal-only — deliberately never
  // surfaced on the public passport page (see components/PublicScanPage.tsx),
  // since notes may reference sensitive audit findings.
  notes String? @db.Text

  signatureHash String
  signedAt      DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([passportId])
  @@index([auditorId])
}

// ----------------------------------------------------------------------------
// B2B CLIENT PORTAL & BUYER API ACCESS (new models, no existing model or
// field touched or removed)
// ----------------------------------------------------------------------------
// Same auth shape as the Auditor model above, applied to a different
// actor: an industrial buyer / corporate customer. A Client is a COMPANY,
// not an individual (unlike Auditor, where the credential must identify a
// specific signing person) — one shared companyApiKeyHash per buyer
// account is the right granularity here, since the portal/API only ever
// answers "what has THIS BUYER purchased," never "which employee of the
// buyer looked." See lib/client-auth.ts for the lookup and
// scripts/create-client.ts for provisioning.
model Client {
  id           String  @id @default(uuid())
  companyName  String
  contactEmail String? @unique
  country      String?
  apiKeyHash   String  @unique
  active       Boolean @default(true) // soft-revoke, same convention as Auditor.active

  purchases ClientPassportAccess[]

  createdAt DateTime @default(now())

  @@index([apiKeyHash])
}

// Records that `passport` was sold/allocated to `client`. This is
// deliberately NOT a general order/invoicing system — no price, no
// currency, no line items — just the minimum needed to answer "which
// batches can this buyer see," matching what the B2B portal and Buyer API
// actually need. quantityKg is optional context (a buyer may have
// purchased only part of a batch's total output).
//
// @@unique([clientId, passportId]) keeps this "one allocation per
// buyer per batch" for MVP simplicity — a repeat/topped-up purchase of
// the same batch by the same buyer updates the existing row rather than
// creating a second one; see lib/services/allocate-passport-to-client.ts.
model ClientPassportAccess {
  id String @id @default(uuid())

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  passportId String
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  quantityKg   Decimal? @db.Decimal(10, 3)
  purchaseDate DateTime @default(now())
  notes        String?

  createdAt DateTime @default(now())

  @@unique([clientId, passportId])
  @@index([clientId])
  @@index([passportId])
}

// ----------------------------------------------------------------------------
// MULTI-TIER CHAIN OF CUSTODY (Multi-tier Supply Chain Verification &
// Auditor Portal Expansion — new model, no existing model or field
// touched or removed)
// ----------------------------------------------------------------------------
// One row per upstream supply-chain tier (a raw material supplier, a
// recycler, a compounder, ...) that fed into this passport's batch, each
// carrying its own external batch reference and chain-of-custody
// certificate. Unlike BatchGenealogyLink (which links two batches that are
// BOTH already PolymerPassport rows in this system), the participant here
// is typically external to this platform entirely — see the
// ChainOfCustodyTier enum's own comment.
//
// Submitted by whoever holds the passport (MANUFACTURER/ADMIN — see
// lib/services/add-chain-of-custody-record.ts), starting PENDING_REVIEW,
// same "never implicitly trust a self-submission" convention as
// Certification.verificationStatus. Moved to VERIFIED/FLAGGED/REJECTED
// only by an individually-authenticated Auditor (lib/auditor-auth.ts,
// same identity model as AuditorVerification below) — reviewedBy stores
// "AUDITOR:<id>", mirroring AuditLog.actor's convention.
//
// recordHash is a SHA-256 (via lib/types.ts's hashRecord) over this tier's
// own canonical claim data (tier, participantName, externalBatchId,
// certificateId, ...) — a tamper-evident fingerprint for this one record,
// same principle as PolymerPassport.recordHash and
// AuditorVerification.signatureHash, but deliberately NOT folded into the
// parent passport's own recordHash chain: tier records are added
// post-issuance, on their own timeline, and must never invalidate the
// passport's already-sealed integrity hash the way editing a core claim
// field would.
model ChainOfCustodyRecord {
  id String @id @default(uuid())

  passportId String
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  // Display/traversal order, furthest upstream first (1 = earliest tier).
  // Assigned server-side as "next available" for this passport — see the
  // add-record service — not caller-supplied, so tiers can never collide
  // or be submitted out of order by mistake.
  sequence Int

  tier ChainOfCustodyTier

  // The external organization at this tier — usually NOT a Manufacturer
  // row in this system (see this model's own file banner). Free text by
  // design: onboarding every raw-material supplier as a full system entity
  // is out of scope for this MVP.
  participantName    String
  participantCountry String?

  // This tier's own reference for the material lot/batch — their number,
  // not ours. Free text (external systems use all kinds of batch ID
  // formats), unlike PolymerPassport.batchId which is validated/unique.
  externalBatchId String

  // Chain-of-custody / mass-balance certificate for this tier. Reuses the
  // existing CertificationScheme enum rather than inventing a parallel
  // one — a chain-of-custody certificate (ISCC PLUS, REDcert2, ...) is the
  // same set of real-world schemes a passport's own Certification rows
  // already reference.
  certificationScheme          CertificationScheme?
  certificateId                String?
  certificateDocumentUrl       String?
  certificateDocumentHash      String? // mirrors Certification.documentHash — SHA-256 of the document, never fetched server-side (SSRF avoidance, same reasoning as that field)
  massBalanceAllocationPercent Decimal? @db.Decimal(5, 2) // mirrors Certification's own field; only meaningful for mass-balance schemes

  notes String? @db.Text

  status ChainOfCustodyStatus @default(PENDING_REVIEW)

  // Review outcome — set together, only by the Auditor review action.
  // reviewNotes is required by the API when moving to FLAGGED or REJECTED
  // (mirrors Certification.rejectionReason's "required by the API, not
  // enforced at the DB layer" convention).
  reviewedBy String? // "AUDITOR:<id>", same convention as AuditLog.actor
  reviewedAt DateTime?
  reviewNotes String? @db.Text

  recordHash String?
  hashAlgorithm String @default("SHA-256")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([passportId, sequence])
  @@index([passportId])
  @@index([status])
  @@index([tier])
}

// =============================================================================
// 13. Green Accounting & EU Plastic Tax Tracker
// -----------------------------------------------------------------------------
// Fully additive — no existing model, field, or enum value is changed. Two
// new models:
//   - PlasticTaxParameter: a configurable, versioned tax rate (defaults to
//     the EU Plastic Packaging Tax's real-world benchmark of EUR 800/tonne
//     on non-recycled plastic packaging mass — see the pre-existing
//     EU_PLASTIC_TAX_RATE_EUR_PER_TONNE constant in lib/services/
//     esg-analytics.ts, which this model deliberately does not touch or
//     replace; that constant remains the ESG dashboard's own existing
//     illustrative figure, while this model powers the new dedicated
//     Green Accounting feature).
//   - BatchGreenValuation: an optional, user-triggered, locked snapshot of
//     one passport's plastic-tax financial assessment — mirrors
//     CarbonFootprintCalculation's "compute live by default, persist a
//     snapshot only when explicitly saved" pattern. @@unique on passportId:
//     latest snapshot only, upserted, not appended.
// =============================================================================

model PlasticTaxParameter {
  id String @id @default(uuid())

  jurisdiction String @default("EU")
  label        String @default("EU Plastic Packaging Tax")

  currency     String  @default("EUR")
  ratePerTonne Decimal @db.Decimal(10, 2) // e.g. 800.00 for the EU benchmark

  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  active Boolean @default(true)

  source String? @db.Text // e.g. citation for the rate (regulation, admin note)
  notes  String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  valuations BatchGreenValuation[]

  @@index([jurisdiction])
  @@index([active])
}

model BatchGreenValuation {
  id String @id @default(uuid())

  passportId String          @unique
  passport   PolymerPassport @relation(fields: [passportId], references: [id])

  taxParameterId String
  taxParameter   PlasticTaxParameter @relation(fields: [taxParameterId], references: [id])

  // Inputs snapshotted at valuation time, so a later change to the source
  // batch weight or an updated tax parameter never silently redates a
  // filed/locked valuation.
  batchMassKg   Decimal @db.Decimal(10, 3)
  pcrMassKg     Decimal @db.Decimal(10, 3)
  taxableMassKg Decimal @db.Decimal(10, 3) // batchMassKg - pcrMassKg

  ratePerTonneEurSnapshot Decimal @db.Decimal(10, 2)

  // gross = full liability if 0% were recycled (batchMassKg * rate)
  // savings = financial offset attributable to PCR mass (pcrMassKg * rate)
  // net = gross - savings (liability on the actual taxable mass)
  grossLiabilityEur Decimal @db.Decimal(12, 2)
  pcrTaxSavingsEur  Decimal @db.Decimal(12, 2)
  netLiabilityEur   Decimal @db.Decimal(12, 2)

  valuedAt DateTime @default(now())
  valuedBy String // "ADMIN", same convention as other actor fields in this app

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([passportId])
  @@index([taxParameterId])
}

// =============================================================================
// 14. Supplier Onboarding Portal
// -----------------------------------------------------------------------------
// Fully additive — no existing model, field, or enum value is changed
// (only the new SUPPLIER_SUBMISSION_APPROVED AuditAction value and the two
// new back-relation fields above). Two new models, mirroring the
// established Auditor/AuditorVerification and Client/ClientPassportAccess
// "credential model" + "event/record model" pattern used elsewhere in this
// schema:
//   - SupplierInvite: a standing, reusable credential for one external
//     supplier company, created by an admin. Same auth shape as
//     Auditor.apiKeyHash/Client.apiKeyHash — tokenHash stores a SHA-256
//     hash of the raw token, never the raw value itself; the raw token is
//     shown to the admin exactly once at creation time (see
//     lib/services/supplier-submission.ts's createSupplierInvite) and is
//     embedded in the public submission URL
//     (/supplier/submit/[token]) rather than sent as a header, since this
//     credential is handed to someone outside the system entirely, not
//     configured into a server-to-server client.
//   - SupplierSubmission: one row per individual batch proposal submitted
//     through an invite's link. Starts PENDING — same "never implicitly
//     trust a self-submission" convention as Certification.verificationStatus
//     and ChainOfCustodyRecord.status — and is moved to APPROVED/REJECTED
//     only by an admin review action. An APPROVED submission's data is used
//     to call the existing, canonical lib/services/create-passport.ts
//     (never duplicated — this repo has already been bitten once by two
//     divergent copies of passport-creation logic drifting apart), and the
//     resulting PolymerPassport.id is recorded on resultingPassportId.
//
// Deliberately does NOT introduce any new file-upload/blob-storage
// infrastructure: proposedCertDocumentUrl/proposedCertDocumentHash follow
// the exact same convention as Certification.documentUrl/documentHash
// elsewhere in this schema — a URL text field plus a client-computed
// SHA-256 hash, never fetched server-side (SSRF avoidance).
// =============================================================================

model SupplierInvite {
  id String @id @default(uuid())

  // --- Supplier company details, collected at invite time -------------------
  companyName  String
  contactName  String
  contactEmail String
  contactPhone String?
  country      String // required — Manufacturer.country is itself required, and this is what backs an auto-created Manufacturer row at approval time

  // Cached once a submission through this invite is first approved and a
  // Manufacturer row is resolved/created for this supplier (see
  // lib/services/supplier-submission.ts's approveSupplierSubmission), so
  // every later approval from the same supplier reuses the same
  // Manufacturer row instead of creating a duplicate one. Null until then.
  manufacturerId String?
  manufacturer   Manufacturer? @relation(fields: [manufacturerId], references: [id])

  // SHA-256 hash of the raw invite token embedded in the public submission
  // URL — same "hash at rest, raw value shown once" principle as
  // Auditor.apiKeyHash/Client.apiKeyHash. Looked up via lib/supplier-invite-auth.ts.
  tokenHash String @unique

  // Soft-revoke, same convention as Auditor.active/Client.active — flip
  // false to disable a link without deleting submission history.
  active Boolean @default(true)

  invitedBy String // actor identity, same convention as AuditLog.actor (e.g. "ADMIN")
  invitedAt DateTime @default(now())

  // Optional expiry for the invite link itself (distinct from any
  // individual certification's own validUntil). Null = no expiry.
  expiresAt DateTime?

  submissions SupplierSubmission[]

  createdAt DateTime @default(now())

  @@index([tokenHash])
  @@index([active])
  @@index([manufacturerId])
}

// One row per batch proposal a supplier submits through their invite link.
// Field shape deliberately mirrors a subset of PolymerPassport's own
// "Material Identification" / "Sustainability & Recycled Content" /
// "Supply Chain & Certification" sections plus a single proposed
// certification (matching ChainOfCustodyRecord's own "one certificate
// block per record" convention, rather than PolymerPassport's full
// certifications[] relation) — an admin can add further certifications
// after approval through the existing certificate management flow if a
// batch genuinely needs more than one.
//
// proposedBatchId/proposedGtin are supplier-suggested only, deliberately
// NOT validated against PolymerPassportInputSchema's uniqueness/GS1
// check-digit rules at submission time — external suppliers don't reliably
// know this system's existing batchIds or hold their own GTINs. The admin
// confirms or overrides both at approval time, when the real
// createPassport() call enforces those rules for real.
model SupplierSubmission {
  id String @id @default(uuid())

  inviteId String
  invite   SupplierInvite @relation(fields: [inviteId], references: [id])

  // --- Proposed material identification --------------------------------------
  polymerType     PolymerType
  grade           String
  meltFlowIndex   Decimal? @db.Decimal(6, 2)
  density         Decimal? @db.Decimal(5, 3)
  proposedGtin    String?
  proposedBatchId String?

  // --- Proposed sustainability & recycled content -----------------------------
  recycledContentSource      RecycledContentSource?
  recycledContentPercent     Decimal                @default(0) @db.Decimal(5, 2)
  bioBasedPercent            Decimal                @default(0) @db.Decimal(5, 2)
  carbonFootprintKgCO2ePerKg Decimal                @default(0) @db.Decimal(8, 3)

  // Batch weight context (not itself a PolymerPassport column — informs
  // the admin's review, and can seed a CarbonFootprintCalculation after
  // approval the same way the manual dashboard flow does).
  weightKg Decimal? @db.Decimal(10, 3)

  // --- Proposed certification (single block, see model banner above) --------
  certScheme          CertificationScheme?
  certificateId        String?
  issuingBody          String?
  certValidFrom        DateTime?
  certValidUntil       DateTime?
  certDocumentUrl      String? // mirrors Certification.documentUrl — never fetched server-side
  certDocumentHash     String? // mirrors Certification.documentHash — client-computed SHA-256

  supplierNotes String? @db.Text

  status SupplierSubmissionStatus @default(PENDING)

  submittedAt DateTime @default(now())

  // Review outcome — set together, only by the admin review action.
  // reviewNotes is required by the API when moving to REJECTED (mirrors
  // Certification.rejectionReason's "required by the API, not enforced at
  // the DB layer" convention).
  reviewedBy  String?
  reviewedAt  DateTime?
  reviewNotes String? @db.Text

  // Set only on approval, once the real PolymerPassport row exists.
  resultingPassportId String?          @unique
  resultingPassport   PolymerPassport? @relation(fields: [resultingPassportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([inviteId])
  @@index([status])
  @@index([submittedAt])
}
